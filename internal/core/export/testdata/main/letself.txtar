# A let bound to a bare value reference, like `let X = self`, denotes the
# vertex of the struct declaring it. Where that struct literal is unified into
# another value through a reference, the let clause is not in scope, and it
# cannot be expanded in place either: it is declared again in the struct
# exported for the vertex it denotes.

-- in.cue --
@experiment(aliasv2,try)

// The let is referenced from the source of a for clause.
source: {
	#S: {
		in!: [string]: int
		let X = self
		out: [for k, _ in X.in {k}]
	}
	#T: #S & {}
}

// The let is referenced from a nested struct, a comprehension body and the
// expressions of let and try clauses.
nested: {
	#S: {
		in!: [string]: int
		let X = self
		out: a: {for k, _ in X.in {(k): X.in[k]}}
		lst: [for k, _ in in let v = X.in[k] {v}]
		tr: {for k, _ in in try y = X.in[k]? {(k): y}}
	}
	#T: #S & {}
}

// The value the let denotes has more than one conjunct.
conjuncts: {
	#S: {
		in!: [string]: int
		let X = self
		out: [for k, _ in in {X.in[k]}]
	}
	#T: #S
	#T: in?: [string]: <10
}

== Raw
{

	// The let is referenced from the source of a for clause.
	source: {
		#S: {
			let X = self
			in!: {}
			out: [for k, _ in X.in {
				k
			}]
		}
		#T: {
			let X_1 = self
			in!: {}
			out: [for k, _ in X_1.in {
				k
			}]
		}
	}

	// The let is referenced from a nested struct, a comprehension body and the
	// expressions of let and try clauses.
	nested: {
		#S: {
			let X_2 = self
			in!: {}
			out: a: {for k, _ in X_2.in {
				(k): X_2.in[k]
			}}
			lst: [for k, _ in in let v = X_2.in[k] {
				v
			}]
			tr: {for k, _ in in try y = X_2.in[k]? {
				(k): y
			}}
		}
		#T: {
			let X_3 = self
			in!: {}
			out: a: {for k, _ in X_3.in {
				(k): X_3.in[k]
			}}
			lst: [for k, _ in in let v = X_3.in[k] {
				v
			}]
			tr: {for k, _ in in try y = X_3.in[k]? {
				(k): y
			}}
		}
	}

	// The value the let denotes has more than one conjunct.
	conjuncts: {
		#S: {
			let X_4 = self
			in!: {}
			out: [for k, _ in in {
				X_4.in[k]
			}]
		}
		#T: {
			let X_A = self
			in!: {}
			out: [for k, _ in in {
				X_A.in[k]
			}]
		}
	}
}

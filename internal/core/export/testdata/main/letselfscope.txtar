			let X_5 = self
			in!: {}
			out: [for k, _ in in {
				X_5.in[k]
			}]
		}
	}

	// A field outside #T refers into #T.
	sibling: {
		#S: {
			let X_6 = self
			in!: {}
			out: [for k, _ in X_6.in {
				k
			}]
		}
		#T: {
			let X_7 = self
			in!: {}
			out: [for k, _ in X_7.in {
				k
			}]
		}
		x: [for k, _ in #S.in {
			k
		}]
	}
}

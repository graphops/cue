# A let bound to a bare value reference, like `let X = self`, denotes the
# vertex that the struct literal declaring it is unified into. Where that
# literal is unified into another value through a reference, as in
# #T: #S & {}, the let clause is not in scope where #T is exported. Expanding
# the let in place would write a copy of the value of #T, which no longer
# refers to what #T is unified with later. The let clause is declared again in
# the struct exported for #T instead.
#
# TODO: where no struct is exported for #T, as for x in sibling, the let is
# still expanded as a copy of #T, so x no longer refers to what #T is unified
# with. A reference to #T by its path would, where #T is printed.
# https://cuelang.org/issue/XXXX

-- in.cue --
@experiment(try)

// The let is referenced from the source of a for clause.
source: {
	#S: {
		in!: [string]: int
		let X = self
		out: [for k, _ in X.in {k}]
	}
	#T: #S & {}
}

// The let is referenced from a nested struct, a comprehension body and the
// expressions of let and try clauses.
nested: {
	#S: {
		in!: [string]: int
		let X = self
		out: a: {for k, _ in X.in {(k): X.in[k]}}
		lst: [for k, _ in in let v = X.in[k] {v}]
		tr: {for k, _ in in try y = X.in[k]? {(k): y}}
	}
	#T: #S & {}
}

// The value the let denotes has more than one conjunct.
conjuncts: {
	#S: {
		in!: [string]: int
		let X = self
		out: [for k, _ in in {X.in[k]}]
	}
	#T: #S
	#T: in?: [string]: <10
}

// A field outside #T refers into #T.
sibling: {
	#S: {
		in!: [string]: int
		let X = self
		out: [for k, _ in X.in {k}]
	}
	#T: #S & {}
	x: #T.out
}

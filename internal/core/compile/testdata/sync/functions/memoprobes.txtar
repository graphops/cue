# Calls that share a memoized result must give the result that each would
# compute afresh. Each struct below is one case: callers inside and outside
# definitions, in either order, with opened definitions and embeddings;
# structural cycles through arguments; labels of pattern fields; disjuncts;
# for, let and try clauses; let fields read from several environments;
# aliases; partial application, defaults and signature types; incomplete
# arguments; recursion; and arguments that read the struct holding the call.
#inlinetest:exclude skip — results checked by the golden output
-- in.cue --
@experiment(functions)
@experiment(try)

p01_def_ci_a: {
	F: func(n: _) -> _: n & {b: 2}
	S: {x: F({a: 1})}
	v: S
	#D: S
	d: #D
}
p01_def_ci_b: {
	F: func(n: _) -> _: n & {b: 2}
	S: {x: F({a: 1})}
	#D: S
	d: #D
	v: S
}
p02_def_ci_closed_b: {
	F: func(n: int) -> _: {a: n}
	S: {x: F(1)}
	#D: S
	d: #D & {x: b: 2}
	v: S
	w: v & {x: b: 2}
}
p02_def_ci_closed: {
	F: func(n: int) -> _: {a: n}
	S: {x: F(1)}
	v: S
	#D: S
	w: v & {x: b: 2}
	d: #D & {x: b: 2}
}
p03_cycle_self: {
	F: func(x: _) -> _: {v: x}
	V: {a: 1, r: F(V)}
}
p04_cycle_copy: {
	F: func(x: _) -> _: {v: x}
	G: func(x: _) -> _: {w: F(x)}
	T: {a: 1}
	S: {p: G(T), q: p}
	u: S
	w: u.q.w.v
}
p05_label: {
	F: func(s: string) -> string: "<" + s + ">"
	x: [string]~(Name, _): {r: F(Name)}
	x: {a: _, b: _}
	y: x
}
p06_disj: {
	F: func(n: int) -> int: n + 1
	#T: {k: int, s: {r: F(k)}}
	x: #T & ({k: 1} | {k: 2})
	y: [x & {k: 1}, x & {k: 2}]
}
p07_disj_closure: {
	#T: {k: int, f: func() -> int: k + 10, r: f()}
	x: #T & ({k: 1} | {k: 2})
	z: [x & {k: 1}, x & {k: 2}]
}
p08_for: {
	F: func(n: int) -> {...}: {v: n, w: n * 2}
	src: {a: 1, b: 2}
	out: [for k, v in src {F(v)}]
	S: {o: [for k, v in src {F(v)}], p: o}
	c1: S
	c2: S
}
p09_for_nested_copy: {
	F: func(n: int) -> {...}: {v: n}
	S: {src: {a: 1, b: 2}, o: [for k, v in src {F(v)}]}
	c1: S & {src: c: 3}
	c2: S
}
p10_let_field: {
	F: func(n: _) -> _: {v: n}
	S: {
		let L = k
		k: int
		r: F(L)
	}
	a: S & {k: 1}
	b: S & {k: 2}
}
p11_let_clause: {
	F: func(n: _) -> _: {v: n}
	src: {a: 1, b: 2}
	out: [for k, v in src let L = v + 1 {F(L)}]
	S: {o: [for k, v in src let L = v + 1 {F(L)}]}
	c: [S, S]
}
p12_value_alias: {
	F: func(n: _) -> _: n + 1
	S: {
		let X = self
		b: int
		r: F(X.b)
	}
	a: S & {b: 1}
	c: S & {b: 2}
}
p12b_field_alias: {
	F: func(n: _) -> _: {v: n.b}
	S~X: {b: 1, r: F(X)}
	a: S & {b: 1}
}
p13_pattern_closure: {
	p: [string]~(K, _): func() -> string: K
	p: {a: _, b: _}
	out: [for k, _ in p {p[k]()}]
}
p14_partial: {
	F: func(a: int, b: int) -> int: a * 10 + b
	S: {g: F(1, ...), r: g(2)}
	T: {g: F(3, ...), r: g(2)}
	u: [S, T, S.r, T.r]
}
p15_incomplete_later: {
	F: func(n: int) -> {...}: {v: n}
	S: {k: int, r: F(k)}
	a: S & {k: 1}
	b: S & {k: 2}
	c: S
}
p16_try: {
	F: func(n: _) -> _: {v: n}
	src: {a: {x: 1}, b: {}}
	out: [for k, v in src try { y: F(v.x?) }]
	S: {o: [for k, v in src try { y: F(v.x?) }]}
	c: [S, S]
}
p17_try_bind: {
	F: func(n: _) -> _: {v: n}
	src: {a: {x: 1}, b: {x: 2}}
	S: {out: [for k, v in src try X = v.x? { y: F(X) }]}
	c: [S, S]
}
p18_recursion: {
	Fact: func(n: int) -> int: [if n <= 1 {1}, n * Fact(n - 1)][0]
	a: Fact(5)
	S: {r: Fact(4)}
	b: [S, S]
}
p19_param_default: {
	F: func(n: int = 3) -> {...}: {v: n}
	S: {r: F()}
	T: {r: F(4)}
	u: [S, T, S]
}
p20_sig_type: {
	F: func(n: _) -> _: {v: n}
	G: F & func(n: int) -> {...}
	S: {a: F(1), b: G(1)}
	c: [S, S]
}
p21_def_arg_a: {
	F: func(n: _) -> _: n & {b: 2}
	K: {a: 1}
	S: {x: F(K)}
	v: S
	#D: S
	d: #D
}
p21_def_arg_b: {
	F: func(n: _) -> _: n & {b: 2}
	K: {a: 1}
	S: {x: F(K)}
	#D: S
	d: #D
	v: S
}
p22_def_arg_direct: {
	F: func(n: _) -> _: n & {b: 2}
	K: {a: 1}
	v: {x: F(K)}
	#D: {x: F(K)}
}
p23_def_arg_shared: {
	F: func(n: _) -> _: {r: n & {b: 2}}
	K: {a: 1}
	S: {x: F(K)}
	v: S
	#D: S
}
p24_cycle_ctx_a: {
	F: func(x: _) -> _: {v: x}
	S: {r: F(A)}
	w: S
	A: S
}
p24_cycle_ctx_b: {
	F: func(x: _) -> _: {v: x}
	S: {r: F(A)}
	A: S
	w: S
}
p25_cycle_ctx_field: {
	F: func(x: _) -> _: {v: x.k}
	S: {k: 1, r: F(A)}
	w: S
	A: S
}
p26_cycle_arg_in_self: {
	F: func(x: _) -> _: {v: x}
	S: {r: F(B)}
	B: {s: S}
	w: S
}
p27_stale_a: {
	F: func(x: _) -> _: {v: x.p}
	T: {r: F(V)}
	V: T
	V: {for k, _ in src {(k): 1}}
	src: {p: _}
	W: T
}
p27_stale_b: {
	F: func(x: _) -> _: {n: len(x)}
	T: {r: F(V)}
	V: T
	V: {for k, _ in src {(k): 1}}
	src: {p: _, q: _}
	W: T
}
p27_stale_c: {
	F: func(x: _) -> _: {n: len([for k, _ in x {k}])}
	T: {r: F(V.s)}
	V: T
	V: s: {for k, _ in src {(k): 1}}
	V: s: z: 0
	src: {p: _, q: _}
	W: T
}
p28_multilet: {
	G: func(n: string) -> string: "sp-" + n
	S: {
		for e in [{name: "a"}, {name: "b"}] {
			let R = e.name
			(e.name): {policy: G(R)}
		}
	}
	T: S
}
p29_multilet_call: {
	G: func(n: string) -> string: "sp-" + n
	F: func(e: _) -> {...}: {
		let R = e.name
		(e.name): {policy: G(R)}
	}
	S: {
		F({name: "a"})
		F({name: "b"})
	}
	T: S
}
p30_keyonly: {
	F: func(s: _) -> _: {v: s}
	src: {a: 1, b: 2}
	W: func(n: int) -> {...}: {o: [for k, _ in src {F(k)}], p: [for i, _ in [5, 6] {F(i)}]}
	L: func(n: int) -> {...}: {m: W(n), c1: m, c2: m}
	r: L(1)
}
c05_argdef_a: {
	F: func(n: _) -> _: {r: n}
	#K: {a: int}

    #Args: (〈0;#Map〉|string)
    #Out: {
      args?: 〈1;#Args〉
    }
    out: 〈0;#Out〉
    out: {
      args: 〈1;x〉.args
    }
    x: {
      args: 〈1;y〉.args
    }
    y: {
      args: 〈1;#A〉
    }
    #A: 〈0;#B〉
    #B: {
      c: "3"
      if true {
        a: "1"
      }
    }
  }
  sharedDisjunction: {
    #Map: {
      [string]: string
    }
    #Args: (〈0;#Map〉|string)
    out: {
      args: 〈1;x〉.args
    }
    out: {

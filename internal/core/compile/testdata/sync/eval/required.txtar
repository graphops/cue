-- in.cue --
self: t1: {
	a?: int
}

self: t2: {
	a!: int
	a!: int
}

unify: t1: {
	a!: int
	a: int
}

unify: t2: {
	a!: int
	a?: int
}

#Def: t1: {
	a!: int
}

// A required field makes a value a struct, so it conflicts with an embedded
// scalar even though the field is not present.
embedScalar: t1: {
	1
	a!: int
}

// Required fields do not cause vet to fail with definitions: a required field
// in one definition should block a disallowed field from another definition.
// https://cuelang.org/issue/2306
allowed: {
	issue2306: {
		#A: a!: int
		#A: #B

		#B: b!: int
	}
}

reference: {
	toWithinDefinition: {
		#Foo: a!: int
		b: #Foo.a
	}
	toFieldFromDefinition: {
		#Foo: a!: int
		b: #Foo
		c: b.a
	}
	toNonDefinition: {
		x: y!: _
		b: x.y
	}
	toConcrete: {
		a!: 1
		b: a + 1
	}
	// A reference to a required-but-missing field reports "required field
	// missing", not "cannot reference optional field".
	// https://cuelang.org/issue/2937
	issue2937: {
		min!: number
		max!: number & >min
		max:  10
	}
	// Calling a required-but-missing field reports the missing field, rather
	// than complaining that an error is not a function.
	// https://cuelang.org/issue/4330
	issue4330: {
		#Foo: fn!: _
		b: #Foo.fn("foo")
	}
}
-- issue3918.cue --
import "strings"

// Required fields do not work on the function pattern: a required field used
// as an input to a definition-based function was not satisfied at the call site.
// https://cuelang.org/issue/3918
issue3918: {
	reduced: {
		#disjuncts: {
			in!: [...string]
			out: strings.Join(in, "|")
		}

		x: (#disjuncts & {
			in: ["foo", "bar"]
		}).out
	}
	noFunction: {
		#disjuncts: {
			in!: [...string]
			out: in
		}
		_foo: #disjuncts & {}
		x: _foo.out
	}
}
// A required field error is incomplete error. Ensure that setting a vertex
// to this error does not escalate it to an evaluation error.
doNotEscalateError: {
	a: {
		in:  _
		out: in.self
	}
	b: {
		required!: _
		pass:    (a & {in: required}).out
	}
}
-- scalar.cue --
// A reference to a required field is incomplete. Unifying it with a scalar
// that equals the value of the field leaves it incomplete: the incomplete
// error of the reference is not the result of comparing the two scalars.
// https://cuelang.org/issue/XXXX
scalar: {
	// Each kind of scalar, and either order of the conjuncts.
	string: {
		a!: "x"
		b:  a
		b:  "x"
	}
	number: {
		a!: 5
		b:  a
		b:  5
	}
	nullValue: {
		a!: null
		b:  a
		b:  null
	}
	valueFirst: {
		a!: "x"
		b:  "x"
		b:  a
	}
	// The required field is reached through a selector and a definition.
	selector: {
		s: a!: "x"
		b: s.a
		b: "x"
	}
	definition: {
		#D: a!: "x"
		d: #D
		b: d.a
		b: "x"
	}
	// What reads the field sees an incomplete value, not a conflict.
	consumers: {
		a!: "x"
		b:  a
		b:  "x"
		guard: [if b == "x" {1}]
		default: b | *"d"
	}
	// A disjunct referring to the field next to an equal scalar is
	// incomplete, so is the disjunction once the other disjunct fails.
	disjunct: {
		a!: "x"
		c: {b: a} | {b: "o"}
		c: b: "x"
	}

	// Scalars that differ still conflict, as do numbers of different kinds,
	// which the comparison itself reports.
	differ: {
		a!: "x"
		b:  a
		b:  "y"
	}
	kinds: {
		a!: 1.0
		b:  a
		b:  1
	}
	// A disjunct that fails otherwise is still eliminated.
	eliminated: {
		a!: "x"
		c: {b: a} | {b: "x"}
		c: b: "x"
	}
}
-- out/compile --
--- in.cue
{
  self: {
    t1: {
      a?: int
    }
  }
  self: {
    t2: {
      a!: int
      a!: int
    }
  }
  unify: {
    t1: {
      a!: int
      a: int
    }
  }
  unify: {
    t2: {
      a!: int
      a?: int
    }
  }
  #Def: {
    t1: {
      a!: int
    }
  }
  embedScalar: {
    t1: {
      1
      a!: int
    }
  }
  allowed: {
    issue2306: {
      #A: {
        a!: int
      }
      #A: 〈0;#B〉
      #B: {
        b!: int
      }
    }
  }
  reference: {
    toWithinDefinition: {
      #Foo: {
        a!: int
      }
      b: 〈0;#Foo〉.a
    }
    toFieldFromDefinition: {
      #Foo: {
        a!: int
      }
      b: 〈0;#Foo〉
      c: 〈0;b〉.a
    }
    toNonDefinition: {
      x: {
        y!: _
      }
      b: 〈0;x〉.y
    }
    toConcrete: {
      a!: 1
      b: (〈0;a〉 + 1)
    }
    issue2937: {
      min!: number
      max!: (number & >〈0;min〉)
      max: 10
    }
    issue4330: {
      #Foo: {
        fn!: _
      }
      b: 〈0;#Foo〉.fn("foo")
    }
  }
}
--- issue3918.cue
{
  issue3918: {
    reduced: {
      #disjuncts: {
        in!: [
          ...string,
        ]
        out: 〈import;strings〉.Join(〈0;in〉, "|")
      }
      x: (〈0;#disjuncts〉 & {
        in: [
          "foo",
          "bar",
        ]
      }).out
    }
    noFunction: {
      #disjuncts: {
        in!: [
          ...string,
        ]
        out: 〈0;in〉
      }
      _foo: (〈0;#disjuncts〉 & {})
      x: 〈0;_foo〉.out
    }
  }
  doNotEscalateError: {
    a: {
      in: _
      out: 〈0;in〉.self
    }
    b: {
      required!: _
      pass: (〈1;a〉 & {
        in: 〈1;required〉
      }).out
    }
  }
}
--- scalar.cue
{
  scalar: {
    string: {
      a!: "x"
      b: 〈0;a〉
      b: "x"
    }
    number: {
      a!: 5
      b: 〈0;a〉
      b: 5
    }
    nullValue: {
      a!: null
      b: 〈0;a〉
      b: null
    }
    valueFirst: {
      a!: "x"
      b: "x"
      b: 〈0;a〉
    }
    selector: {
      s: {
        a!: "x"
      }
      b: 〈0;s〉.a
      b: "x"
    }
    definition: {
      #D: {
        a!: "x"
      }
      d: 〈0;#D〉
      b: 〈0;d〉.a
      b: "x"
    }
    consumers: {
      a!: "x"
      b: 〈0;a〉
      b: "x"
      guard: [
        if (〈1;b〉 == "x") {
          1
        },
      ]
      default: (〈0;b〉|*"d")
    }
    disjunct: {
      a!: "x"
      c: ({
        b: 〈1;a〉
      }|{
        b: "o"
      })
      c: {
        b: "x"
      }
    }
    differ: {
      a!: "x"
      b: 〈0;a〉
      b: "y"
    }
    kinds: {
      a!: 1.0
      b: 〈0;a〉
      b: 1
    }
    eliminated: {
      a!: "x"
      c: ({
        b: 〈1;a〉
      }|{
        b: "x"
      })
      c: {
        b: "x"
      }
    }
  }
}

# Tests that a call is not reported as a structural cycle when it is inherited
# from a cycle that its arguments do not refer to.
#
# With b: c, c: b and b: z: b.v, looking up b while c is evaluated closes a
# cycle on the reference to c in b, and every conjunct b inherits from c is
# marked cyclic, including the call in c: x: len(k). A call in a cyclic
# conjunct was postponed until its node had a non-cyclic conjunct whenever an
# argument had a reference. b.x has none, so it became a structural cycle,
# while c.x evaluated fine, and so did b.x when the call was declared after the
# cycle.
#
# Calls whose arguments do refer to the cycle are still postponed; see
# stillCyclic below and builtins.txtar.
#
# https://cuelang.org/issue/XXXX
-- in.cue --
import "math"

refArg: {
	k: "abc"
	c: x: len(k)
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
structArg: {
	k: {a: 1}
	c: x: len({a: k.a, b: 2})
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
importArg: {
	c: x: math.Floor(math.Pi)
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
// The selected field is not in progress, although c is.
selectionArg: {
	c: x: len(c.y)
	c: y: "abc"
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
selfSelectionArg: {
	c: x: len(self.y)
	c: y: "abc"
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
letArg: {
	let K = "abc"
	c: x: len(K)
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
letSelectionArg: {
	c: {
		let S = self
		x: len(S.y)
		y: "abc"
	}
	b: c
	c: b
	b: v: 1
	b: z: b.v
}

// These evaluated fine before.
literalArg: {
	c: x: len("abc")
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
comprehensionArg: {
	k: [1, 2]
	c: x: len([for v in k {v}])
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
callAfterCycle: {
	k: "abc"
	b: c
	c: b
	b: v: 1
	b: z: b.v
	c: x: len(k)
}
-- files-a.cue --
// The call is in a file before the one that closes the cycle.
files: {
	config: x: len({a: "x"})
}
-- files-b.cue --
files: {
	blueprint~(_,Bp): {config: Cfg}
	config~(_,Cfg): Bp.config

	blueprint: config: b: 1
	blueprint: config: c: blueprint.config.b

}
-- func.cue --
@experiment(functions)

funcStructArg: {
	f: func(s: _) -> _: s.a
	c: x: f({a: "x"})
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
funcRefArg: {
	f: func(s: _) -> _: s.a
	k: {a: "x"}
	c: x: f(k)
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
-- try.cue --
@experiment(try)

import "encoding/json"

// The references of a try clause are found as for any other clause.
tryArg: {
	k: {a: 1}
	c: x: len({try {a: k.a?}})
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
tryAsArg: {
	k: {a: 1}
	c: x: len({try y = k.a? {a: y}})
	b: c
	c: b
	b: v: 1
	b: z: b.v
}
// A try clause that refers to the cycle remains a structural cycle.
tryCyclic: {
	x: y: json.Validate({try {s: x?}}.s)
	x: y: "{}"
}
-- cycle.cue --
import "encoding/json"

// Calls whose arguments refer to the cycle remain structural cycles.
stillCyclic: {
	direct: {
		x: y: json.Validate(x)
		x: y: "{}"
	}
	indirect: {
		data: #c
		data: a: b: "foo"
		#k: #c
		#c: {
			b: string
			a: matchN(1, [#k])
		}
	}
	selection: {
		data: #c
		data: a: b: "foo"
		#c: {
			b: string
			a: matchN(1, [#c.a])
		}
	}
	let: {
		x: {
			let L = x
			y: json.Validate(L)
		}
		x: y: "{}"
	}
}
-- out/compile --
--- cycle.cue
{
  stillCyclic: {
    direct: {
      x: {
        y: 〈import;"encoding/json"〉.Validate(〈1;x〉)
      }
      x: {
        y: "{}"
      }
    }
    indirect: {
      data: 〈0;#c〉
      data: {
        a: {
          b: "foo"
        }
      }
      #k: 〈0;#c〉
      #c: {
        b: string
        a: matchN(1, [
          〈2;#k〉,
        ])
      }
    }
    selection: {
      data: 〈0;#c〉
      data: {
        a: {
          b: "foo"
        }
      }
      #c: {
        b: string
        a: matchN(1, [
          〈2;#c〉.a,
        ])
      }
    }
    let: {
      x: {
        let L#1 = 〈1;x〉
        y: 〈import;"encoding/json"〉.Validate(〈0;let L#1〉)
      }
      x: {
        y: "{}"
      }
    }
  }
}
--- files-a.cue
{
  files: {
    config: {
      x: len({
        a: "x"
      })
    }
  }
}
--- files-b.cue
{
  files: {
    blueprint: {
      config: 〈1;config〉
    }
    config: 〈0;blueprint〉.config
    blueprint: {
      config: {
        b: 1
      }
    }
    blueprint: {
      config: {
        c: 〈2;blueprint〉.config.b
      }
    }
  }
}
--- func.cue
{
  funcStructArg: {
    f: func(s: _) -> _: 〈0;s〉.a
    c: {
      x: 〈1;f〉({
        a: "x"
      })
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  funcRefArg: {
    f: func(s: _) -> _: 〈0;s〉.a
    k: {
      a: "x"
    }
    c: {
      x: 〈1;f〉(〈1;k〉)
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
}
--- in.cue
{
  refArg: {
    k: "abc"
    c: {
      x: len(〈1;k〉)
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  structArg: {
    k: {
      a: 1
    }
    c: {
      x: len({
        a: 〈2;k〉.a
        b: 2
      })
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  importArg: {
    c: {
      x: 〈import;math〉.Floor(〈import;math〉.Pi)
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  selectionArg: {
    c: {
      x: len(〈1;c〉.y)
    }
    c: {
      y: "abc"
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  selfSelectionArg: {
    c: {
      x: len(〈1〉.y)
    }
    c: {
      y: "abc"
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  letArg: {
    let K#2 = "abc"
    c: {
      x: len(〈1;let K#2〉)
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  letSelectionArg: {
    c: {
      let S#3 = 〈1〉
      x: len(〈0;let S#3〉.y)
      y: "abc"
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  literalArg: {
    c: {
      x: len("abc")
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  comprehensionArg: {
    k: [
      1,
      2,
    ]
    c: {
      x: len([
        for _, v in 〈2;k〉 {
          〈1;v〉
        },
      ])
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  callAfterCycle: {
    k: "abc"
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
    c: {
      x: len(〈1;k〉)
    }
  }
}
--- try.cue
{
  tryArg: {
    k: {
      a: 1
    }
    c: {
      x: len({
        try {
          a: 〈3;k〉.a?
        }
      })
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  tryAsArg: {
    k: {
      a: 1
    }
    c: {
      x: len({
        try y = 〈2;k〉.a? {
          a: 〈1;y〉
        }
      })
    }
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
  }
  tryCyclic: {
    x: {
      y: 〈import;"encoding/json"〉.Validate({
        try {
          s: 〈3;x〉?
        }
      }.s)
    }
    x: {
      y: "{}"
    }
  }
}

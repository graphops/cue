    b: {
      z: 〈1;b〉.v
    }
  }
  callAfterCycle: {
    b: 〈0;c〉
    c: 〈0;b〉
    b: {
      v: 1
    }
    b: {
      z: 〈1;b〉.v
    }
    f: func(s: _) -> _: 〈0;s〉.a
    c: {
      x: 〈1;f〉({
        a: "x"
      })

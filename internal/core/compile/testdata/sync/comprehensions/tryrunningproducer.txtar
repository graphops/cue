# Tests that a lookup does not decide on the type of an arc that a running
# comprehension may still declare.
#
# The guard of the comprehension that sets imp looks up x. That runs another
# comprehension, a parent task of x, which reads imp while the first one, the
# producer of imp, is still evaluating its guard. The freeze cycle-breaker
# then committed imp as an optional arc before imp: true arrived. With an if
# clause, this was reported as a spurious "changed after evaluation" cycle;
# with a try clause, the try body was silently discarded.
#
# https://cuelang.org/issue/XXXX
-- in.cue --
@experiment(try)

// imp becomes true, so the comprehension applies and conflicts with enabled.
ifGuard: {
	c: #If
	c: {
		if c.x != _|_ {imp: true}
		enabled: false
		x: {}
	}
}

// The same with a try clause.
tryDiscarded: {
	c: #Try
	c: {
		if c.x != _|_ {imp: true}
		enabled: false
		x: {}
	}
}

// The same with a definition-free struct and an existence check in the body.
tryInline: {
	c: {
		if c.x != _|_ {imp: true}
		enabled?: _
		imp?:     bool
		x?:       _
		try I = imp? {
			if I {
				enabled: true
				x?:      _
			}
		}
		enabled: false
		x: {}
	}
}

// The struct form, whose body reads imp itself.
tryStruct: {
	c: {
		if c.x != _|_ {imp: true}
		imp?: bool
		x:    {}
		try {
			a:  imp?
			x!: _
		}
	}
}

// The try clause that reads imp is nested in the body of another one.
tryNested: {
	c: {
		if c.x != _|_ {imp: true}
		imp?: bool
		x:    {}
		try {
			a: imp?
			try {
				if imp? {x!: _}
			}
		}
	}
}

// imp becomes true and the body holds.
tryApplies: {
	c: #Try
	c: {
		if c.x != _|_ {imp: true}
		enabled: true
		x: {}
	}
}

// imp stays absent, so the try body is discarded.
tryAbsent: {
	c: #Try
	c: {
		if c.x != _|_ {imp: true}
		enabled: false
	}
}

// The nested try clause waits for imp, but the outer body has already
// settled imp by the time its evaluation returns, so the outer one decides.
settledInBody: {
	c: {
		if c.x != _|_ {imp: true}
		if c.x != _|_ {imp2: true}
		imp?:  bool
		imp2?: bool
		x:     {}
		try {
			a: imp2?
			try {
				if imp? {x!: _}
			}
		}
	}
}

// The nested try clause waits for imp, and so does the outer one. The arcs
// that the nested one may still declare in the outer body are not reported
// as missing.
suspendedInBody: {
	c: {
		if c.x != _|_ {imp: true}
		if c.x != _|_ {imp2: true}
		imp?:  bool
		imp2?: bool
		x:     {}
		try {
			try {
				if imp? {x!: _}
			}
			a: imp2?
		}
	}
}

#If: {
	enabled?: _
	imp?:     bool
	x?:       _
	if imp != _|_ {
		if imp {
			enabled: true
			x!:      _
		}
	}
}

#Try: {
	enabled?: _
	imp?:     bool
	x?:       _
	try I = imp? {
		if I {
			enabled: true
			x!:      _
		}
	}
}
-- out/compile --
--- in.cue
{
  ifGuard: {
    c: 〈1;#If〉
    c: {
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp: true
      }
      enabled: false
      x: {}
    }
  }
  tryDiscarded: {
    c: 〈1;#Try〉
    c: {
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp: true
      }
      enabled: false
      x: {}
    }
  }
  tryInline: {
    c: {
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp: true
      }
      enabled?: _
      imp?: bool
      x?: _
      try I = 〈0;imp〉? {
        if 〈1;I〉 {
          enabled: true
          x?: _
        }
      }
      enabled: false
      x: {}
    }
  }
  tryStruct: {
    c: {
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp: true
      }
      imp?: bool
      x: {}
      try {
        a: 〈1;imp〉?
        x!: _
      }
    }
  }
  tryNested: {
    c: {
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp: true
      }
      imp?: bool
      x: {}
      try {
        a: 〈1;imp〉?
        try {
          if 〈2;imp〉? {
            x!: _
          }
        }
      }
    }
  }
  tryApplies: {
    c: 〈1;#Try〉
    c: {
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp: true
      }
      enabled: true
      x: {}
    }
  }
  tryAbsent: {
    c: 〈1;#Try〉
    c: {
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp: true
      }
      enabled: false
    }
  }
  settledInBody: {
    c: {
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp: true
      }
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp2: true
      }
      imp?: bool
      imp2?: bool
      x: {}
      try {
        a: 〈1;imp2〉?
        try {
          if 〈2;imp〉? {
            x!: _
          }
        }
      }
    }
  }
  suspendedInBody: {
    c: {
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp: true
      }
      if (〈1;c〉.x != _|_(explicit error (_|_ literal) in source)) {
        imp2: true
      }
      imp?: bool
      imp2?: bool
      x: {}
      try {
        try {
          if 〈2;imp〉? {
            x!: _
          }
        }
        a: 〈1;imp2〉?
      }
    }
  }
  #If: {
    enabled?: _
    imp?: bool
    x?: _
    if (〈0;imp〉 != _|_(explicit error (_|_ literal) in source)) {
      if 〈1;imp〉 {
        enabled: true
        x!: _
      }
    }
  }
  #Try: {
    enabled?: _
    imp?: bool
    x?: _
    try I = 〈0;imp〉? {
      if 〈1;I〉 {
        enabled: true
        x!: _
      }
    }
  }
}

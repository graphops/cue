# Tests that an arc that a pushed-down comprehension declares does not
# complete before that comprehension is done.
#
# Iterating over x.paths creates the arc u as a pending placeholder, whose
# only parent task is the if comprehension that declares it. paths does not
# count that comprehension, as its dependency was pushed down onto u, so u
# completed and froze its value while it still had no conjuncts or tasks.
# The comprehension then added cfg.p to u too late: the interpolation saw only
# the pattern string.
# https://cuelang.org/issue/XXXX
-- in.cue --
forSource: {
	out: [for k, p in x.paths {"s3://\(p)"}]
	x: {
		paths: [string]: string
		paths: {if cfg.on {u: cfg.p}}
	}
	cfg: {on: true, p: "v"}
}

sibling: {
	out: x.data
	x: {
		paths: [string]: string & !=""
		paths: {if cfg.on {u: cfg.p}}
		data: {for k, p in paths {(k): "s3://\(p)"}}
	}
	cfg: {on: true, p: "v"}
}

// The comprehension yields nothing, so the arc is not a field.
yieldsNothing: {
	out: [for k, p in x.paths {k}]
	x: paths: {if cfg.on {u: cfg.p}}
	cfg: {on: false, p: "v"}
}

// Each guard reads the field that the other comprehension declares. Both
// comprehensions are running when the other reads the field, so waiting for
// them would never end: the cycle is reported.
cycle: {
	b: {
		if a.bar == _|_ {foo: ""}
	}
	a: {
		if b.foo == _|_ {bar: ""}
	}
}
// The comprehension adds the only conjunct of d, a disjunction, and d is
// unified only after the comprehension is done. Releasing d must not complete
// it then, before its own conjuncts are evaluated: the disjunction of p would
// lose its default and the conjunct "v" along with it.
unifiedAfterRelease: {
	out: x.s.d.p
	x: #S & {
		if true {
			s: d: #D
		}
	}
	#D: *{p: *"v" | string} | {}
	#S: s?: #T
	#T: d?: #U
	#U: {...} | {}
}
-- out/compile --
--- in.cue
{
  forSource: {
    out: [
      for k, p in 〈1;x〉.paths {
        "s3://\(〈1;p〉)"
      },
    ]
    x: {
      paths: {
        [string]: string
      }
      paths: {
        if 〈2;cfg〉.on {
          u: 〈3;cfg〉.p
        }
      }
    }
    cfg: {
      on: true
      p: "v"
    }
  }
  sibling: {
    out: 〈0;x〉.data
    x: {
      paths: {
        [string]: (string & !="")
      }
      paths: {
        if 〈2;cfg〉.on {
          u: 〈3;cfg〉.p
        }
      }
      data: {
        for k, p in 〈1;paths〉 {
          〈1;k〉: "s3://\(〈1;p〉)"
        }
      }
    }
    cfg: {
      on: true
      p: "v"
    }
  }
  yieldsNothing: {
    out: [
      for k, p in 〈1;x〉.paths {
        〈1;k〉
      },
    ]
    x: {
      paths: {
        if 〈2;cfg〉.on {
          u: 〈3;cfg〉.p
        }
      }
    }
    cfg: {
      on: false
      p: "v"
    }
  }
  cycle: {
    b: {
      if (〈1;a〉.bar == _|_(explicit error (_|_ literal) in source)) {
        foo: ""
      }
    }
    a: {
      if (〈1;b〉.foo == _|_(explicit error (_|_ literal) in source)) {
        bar: ""
      }
    }
  }
  unifiedAfterRelease: {
    out: 〈0;x〉.s.d.p
    x: (〈0;#S〉 & {
      if true {
        s: {
          d: 〈3;#D〉
        }
      }
    })
    #D: (*{
      p: (*"v"|string)
    }|{})
    #S: {
      s?: 〈1;#T〉
    }
    #T: {
      d?: 〈1;#U〉
    }
    #U: ({
      ...
    }|{})
  }
}

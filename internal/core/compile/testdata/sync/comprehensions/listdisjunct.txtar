# Tests a list with a comprehension that refers to the node the list is
# unified into, where the node also has a disjunction. The comprehension
# resolves the disjunction before the list is complete, and the node takes
# the value of the disjunct, which holds the whole list. The list must not
# replace that value afterwards. Otherwise the node kept the closedness of a
# definition such as #A, but not the disjunct of #A that allows the
# elements, which it reported as not allowed.
#
# cmd/cue/cmd/testdata/script/eval_listdisjunct.txtar tests the same with
# structure sharing disabled.
# https://cuelang.org/issue/XXXX
-- in.cue --
// The list is added through a field.
scalars: {
	#S: [...]
	#A: #S | int
	x: [1, if out[0] == 1 {2}]
	out: x & #A
}

// The list is added directly.
direct: {
	#A: [...] | int
	out: #A & [1, if out[0] == 1 {2}]
}

// The elements are structs.
structs: {
	#A: [...] | int
	x: [{a: 1}, if out[0].a == 1 {{a: 2}}]
	out: x & #A
}

// The definition constrains the elements.
typedElems: {
	#A: [...int] | string
	x: [1, if out[0] == 1 {2}]
	out: x & #A
}

// The definition closes the structs in the list.
closedStructs: {
	ok: {
		#A: [...{a: int}] | int
		x: [{a: 1}, if out[0].a == 1 {{a: 2}}]
		out: x & #A
	}
	notAllowed: {
		#A: [...{a: int}] | int
		x: [{a: 1}, if out[0].a == 1 {{a: 2, b: 3}}]
		out: x & #A
	}
}

// The definition is a list of fixed length.
closedList: {
	ok: {
		#A: [int, int] | int
		x: [1, if out[0] == 1 {2}]
		out: x & #A
	}
	tooLong: {
		#A: [int, int] | int
		x: [1, if out[0] == 1 {2}, 3]
		out: x & #A
	}
}

// The elements must still match the disjunct.
wrongElem: {
	#A: [...string] | int
	x: [1, if out[0] == 1 {2}]
	out: x & #A
}

// The list is in a struct.
inStruct: {
	#S: [...]
	#A: #S | int
	x: {a: [1, if out.a[0] == 1 {2}]}
	out: x & {a: #A}
}

// A for comprehension.
forClause: {
	#A: [...] | int
	x: [1, for v in [0] if out[0] == 1 {2}]
	out: x & #A
}

// The list is unified with two disjunctions.
twoDisjunctions: {
	#A: [...] | int
	#B: [...int] | string
	x: [1, if out[0] == 1 {2}]
	out: x & #A & #B
}

// Nested lists.
nested: {
	#A: [...[...int]] | int
	x: [[1], if out[0][0] == 1 {[2]}]
	out: x & #A
}

// Without a disjunction, the list was not affected.
noDisjunction: {
	#S: [...]
	x: [1, if out[0] == 1 {2}]
	out: x & #S
}
-- out/compile --
--- in.cue
{
  scalars: {
    #S: [
      ...,
    ]
    #A: (〈0;#S〉|int)
    x: [
      1,
      if (〈1;out〉[0] == 1) {
        2
      },
    ]
    out: (〈0;x〉 & 〈0;#A〉)
  }
  direct: {
    #A: ([
      ...,
    ]|int)
    out: (〈0;#A〉 & [
      1,
      if (〈1;out〉[0] == 1) {
        2
      },
    ])
  }
  structs: {
    #A: ([
      ...,
    ]|int)
    x: [
      {
        a: 1
      },
      if (〈1;out〉[0].a == 1) {
        {
          a: 2
        }
      },
    ]
    out: (〈0;x〉 & 〈0;#A〉)
  }
  typedElems: {
    #A: ([
      ...int,
    ]|string)
    x: [
      1,
      if (〈1;out〉[0] == 1) {
        2
      },
    ]
    out: (〈0;x〉 & 〈0;#A〉)
  }
  closedStructs: {
    ok: {
      #A: ([
        ...{
          a: int
        },
      ]|int)
      x: [
        {
          a: 1
        },
        if (〈1;out〉[0].a == 1) {
          {
            a: 2
          }
        },
      ]
      out: (〈0;x〉 & 〈0;#A〉)
    }
    notAllowed: {
      #A: ([
        ...{
          a: int
        },
      ]|int)
      x: [
        {
          a: 1
        },
        if (〈1;out〉[0].a == 1) {
          {
            a: 2
            b: 3
          }
        },
      ]
      out: (〈0;x〉 & 〈0;#A〉)
    }
  }
  closedList: {
    ok: {
      #A: ([
        int,
        int,
      ]|int)
      x: [
        1,
        if (〈1;out〉[0] == 1) {
          2
        },
      ]
      out: (〈0;x〉 & 〈0;#A〉)
    }
    tooLong: {
      #A: ([
        int,
        int,
      ]|int)
      x: [
        1,
        if (〈1;out〉[0] == 1) {
          2
        },
        3,
      ]
      out: (〈0;x〉 & 〈0;#A〉)
    }
  }
  wrongElem: {
    #A: ([
      ...string,
    ]|int)
    x: [
      1,
      if (〈1;out〉[0] == 1) {
        2
      },
    ]
    out: (〈0;x〉 & 〈0;#A〉)
  }
  inStruct: {
    #S: [
      ...,
    ]
    #A: (〈0;#S〉|int)
    x: {
      a: [
        1,
        if (〈2;out〉.a[0] == 1) {
          2
        },
      ]
    }
    out: (〈0;x〉 & {
      a: 〈1;#A〉
    })
  }
  forClause: {
    #A: ([
      ...,
    ]|int)
    x: [
      1,
      for _, v in [
        0,
      ] if (〈2;out〉[0] == 1) {
        2
      },
    ]
    out: (〈0;x〉 & 〈0;#A〉)
  }
  twoDisjunctions: {
    #A: ([
      ...,
    ]|int)
    #B: ([
      ...int,
    ]|string)
    x: [
      1,
      if (〈1;out〉[0] == 1) {
        2
      },
    ]
    out: ((〈0;x〉 & 〈0;#A〉) & 〈0;#B〉)
  }
  nested: {
    #A: ([
      ...[
        ...int,
      ],
    ]|int)
    x: [
      [
        1,
      ],
      if (〈1;out〉[0][0] == 1) {
        [
          2,
        ]
      },
    ]
    out: (〈0;x〉 & 〈0;#A〉)
  }
  noDisjunction: {
    #S: [
      ...,
    ]
    x: [
      1,
      if (〈1;out〉[0] == 1) {
        2
      },
    ]
    out: (〈0;x〉 & 〈0;#S〉)
  }
}

# A function applied to the result of an earlier call of the same call site,
# where a definition is applied to the argument both times. Keeping a node
# structure shared past a repeated definition must not apply to a node that
# shares a function argument: references into the parameter would then
# dereference to the earlier result and evaluate it with the callee's
# cycle-reference chain, reporting a spurious structural cycle.
#inlinetest:exclude golden output records function values and lets
-- in.cue --
@experiment(functions)

#R: {...}

// The definition is the parameter constraint and the result type.
F: func(r: #R) -> #R: {
	let L = {p: {}}
	r
	x: G(L)
}
G: func(a: {...}) -> {...}: {y: H(a.p)}
H: func(b: {...}) -> {...}: {for _, v in b {v}}

W: func(o: {d: #R}) -> _: F(o.d)
once:  W({d: {}})
twice: W({d: once})

// The definition only on the parameter of the wrapper.
FP: func(r: _) -> _: {
	let L = {p: {}}
	r
	x: G(L)
}
WP: func(o: {d: #R}) -> _: FP(o.d)
onceP:  WP({d: {}})
twiceP: WP({d: onceP})

// A Deployment-shaped resource put through a function that adds labels to
// its pod template, then put through it again.
#Resource: {
	kind!: string
	...
}
Apply: func(r: #Resource) -> #Resource: {
	let Rules = {podTemplate: {}}
	r
	spec: template: metadata: templateMetadata(Rules)
}
templateMetadata: func(rules: {...}) -> {...}: {labels: labelSet(rules.podTemplate)}
labelSet: func(rules: {...}) -> {...}: {for _, rule in rules {rule}}
#Out: phases: workload: [string]: #Resource
Resources: func(o: #Out) -> [...]: [Apply(o.phases.workload.d)]
deploy: {
	kind: "Deployment"
	spec: template: spec: {}
}
resOnce:  Resources({phases: workload: d: deploy})
resTwice: Resources({phases: workload: d: resOnce[0]})

-- out/evalalpha --
(struct){
  #R: (#struct){
  }
  F: (func){ func(r: 〈0;#R〉) -> 〈0;#R〉: {
      let L#1 = {
        p: {}
      }
      〈1;r〉
      x: 〈2;G〉(〈0;let L#1〉)
    } }
  G: (func){ func(a: {
      ...
    }) -> {
      ...
    }: {
      y: 〈2;H〉(〈1;a〉.p)
    } }
  H: (func){ func(b: {
      ...
    }) -> {
      ...
    }: {
      for _, v in 〈1;b〉 {
        〈1;v〉
      }
    } }
  W: (func){ func(o: {
      d: 〈1;#R〉
    }) -> _: 〈1;F〉(〈0;o〉.d) }
  once: (#struct){
    let L#1 = (#struct){
      p: (#struct){
      }
    }
    x: (#struct){
      y: (#struct){
      }
    }
  }
  twice: (#struct){
    let L#1multi = {
      p: {}
    }
    x: (#struct){
      y: (#struct){
      }
    }
  }
  FP: (func){ func(r: _) -> _: {
      let L#2 = {
        p: {}
      }
      〈1;r〉
      x: 〈2;G〉(〈0;let L#2〉)
    } }
  WP: (func){ func(o: {
      d: 〈1;#R〉
    }) -> _: 〈1;FP〉(〈0;o〉.d) }
  onceP: (#struct){
    let L#2 = (#struct){
      p: (#struct){
      }
    }
    x: (#struct){
      y: (#struct){
      }
    }
  }
  twiceP: (#struct){
    let L#2multi = {
      p: {}
    }
    x: (#struct){
      y: (#struct){
      }
    }
  }
  #Resource: (#struct){
    kind!: (string){ string }
  }
  Apply: (func){ func(r: 〈0;#Resource〉) -> 〈0;#Resource〉: {
      let Rules#3 = {
        podTemplate: {}
      }
      〈1;r〉
      spec: {
        template: {
          metadata: 〈4;templateMetadata〉(〈2;let Rules#3〉)
        }
      }
    } }
  templateMetadata: (func){ func(rules: {
      ...
    }) -> {
      ...
    }: {
      labels: 〈2;labelSet〉(〈1;rules〉.podTemplate)
    } }
  labelSet: (func){ func(rules: {
      ...
    }) -> {
      ...
    }: {
      for _, rule in 〈1;rules〉 {
        〈1;rule〉
      }
    } }
  #Out: (#struct){
    phases: (#struct){
      workload: (#struct){
      }
    }
  }
  Resources: (func){ func(o: 〈0;#Out〉) -> [
      ...,
    ]: [
      〈2;Apply〉(〈1;o〉.phases.workload.d),
    ] }
  deploy: (struct){
    kind: (string){ "Deployment" }
    spec: (struct){
      template: (struct){
        spec: (struct){
        }
      }
    }
  }
  resOnce: (#list){
    0: (#struct){
      let Rules#3 = (#struct){
        podTemplate: (#struct){
        }
      }
      spec: (#struct){
        template: (#struct){
          metadata: (#struct){
            labels: (#struct){
            }
          }
          spec: (#struct){
          }
        }
      }
      kind: (string){ "Deployment" }
    }
  }
  resTwice: (#list){
    0: (#struct){
      let Rules#3multi = {
        podTemplate: {}
      }
      spec: (#struct){
        template: (#struct){
          metadata: (#struct){
            labels: (#struct){
            }
          }
          spec: (#struct){
          }
        }
      }
      kind: (string){ "Deployment" }
    }
  }
}

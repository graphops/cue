# A call in a comprehension that passes a loop variable to a function is
# evaluated once per arc, not once per evaluation of the comprehension: when
# the struct holding the comprehension is copied, each copy creates new
# iteration environments, but they bind the same arcs.
#inlinetest:exclude skip — performance regression guarded by out/eval/stats
-- in.cue --
@experiment(functions)

Inner: func(n: int) -> {...}: {a: n, b: n + 1, c: [n, n]}
Each: func(xs: [...int]) -> {...}: {
	out: [for x in xs {Inner(x)}]
	copy1: out
	copy2: out
}

r: Each([1, 2, 3])
c1: r.out
c2: r.copy1
c3: [r, r.copy2]
-- out/eval/stats --
Leaks:  3
Freed:  117
Reused: 93
Allocs: 27
Retain: 0

Unifications: 120
Conjuncts:    457
Disjuncts:    0

NumCloseIDs: 108
-- out/evalalpha --
(struct){
  Inner: (func){ func(n: int) -> {
      ...
    }: {
      a: 〈1;n〉
      b: (〈1;n〉 + 1)
      c: [
        〈2;n〉,
        〈2;n〉,
      ]
    } }
  Each: (func){ func(xs: [
      ...int,
    ]) -> {
      ...
    }: {
      out: [
        for _, x in 〈2;xs〉 {
          〈5;Inner〉(〈1;x〉)
        },
      ]
      copy1: 〈0;out〉
      copy2: 〈0;out〉
    } }
  r: (struct){
    out: (#list){
      0: (struct){
        a: (int){ 1 }
        b: (int){ 2 }
        c: (#list){
          0: (int){ 1 }
          1: (int){ 1 }
        }
      }
      1: (struct){
        a: (int){ 2 }
        b: (int){ 3 }
        c: (#list){
          0: (int){ 2 }
          1: (int){ 2 }
        }
      }
      2: (struct){
        a: (int){ 3 }
        b: (int){ 4 }
        c: (#list){
          0: (int){ 3 }
          1: (int){ 3 }
        }
      }
    }
    copy1: ~(r.out)
    copy2: ~(r.out)
  }
  c1: ~(r.out)
  c2: ~(r.out)
  c3: (#list){
    0: ~(r)
    1: ~(r.out)
  }
}

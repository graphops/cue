# A function argument is evaluated with the cycle-reference chain of its call,
# not with that of the callee's body. A vertex of an argument that structure
# shares another vertex must keep that chain for what is reached through it
# by a reference to the parameter, a selection through it or a comprehension
# over it. When what is reached calls a function that the body's chain
# already holds, as when the argument is the result of an earlier call of the
# same function, the call was taken for a structural cycle.
# https://cuelang.org/issue/XXXX
-- in.cue --
@experiment(functions)

// The reproducer of the issue: twice applies W to the result of once.
issue: {
	F: func(r: _) -> _: {r, x: G(1)}
	G: func(a: _) -> _: {y: H(a)}
	H: func(b: _) -> _: b
	W: func(o: _) -> _: F(o)
	once:  W({}) @test(eq, {x: y: 1})
	twice: W(once) @test(eq, {x: y: 1})
}

F: func(r: _) -> _: {
	let L = {p: {q: {z: 1}}}
	r
	x: G(L)
}
G: func(a: _) -> _: {y: H(a.p)}
H: func(b: _) -> _: {for _, v in b {v}}

// The wrapper passes a field of its argument. The body of F iterates over a
// field of a value it builds itself. twice and thrice apply the wrapper to an
// earlier result.
W: func(o: _) -> _: F(o.d)
once:   W({d: {}}) @test(eq, {x: y: z: 1})
twice:  W({d: once}) @test(eq, {x: y: z: 1})
thrice: W({d: twice}) @test(eq, {x: y: z: 1})

// The argument is an earlier result unified with more fields.
fields: W({d: W({d: {a: 1}}) & {b: 2}}) @test(eq, {a: 1, b: 2, x: y: z: 1})

// The wrapper passes its argument itself, and the inner function returns
// its argument rather than iterating over it.
F2: func(r: _) -> _: {
	let L = {p: {q: {z: 1}}}
	r
	x: G2(L)
}
G2: func(a: _) -> _: {y: H2(a.p)}
H2: func(b: _) -> _: b
W2: func(o: _) -> _: F2(o)
once2:  W2({}) @test(eq, {x: y: q: z: 1})
twice2: W2(once2) @test(eq, {x: y: q: z: 1})

// A field of the callee's body that refers to the parameter, referred to in
// turn, keeps the value of the argument.
F3: func(r: _) -> _: {
	let L = {p: {q: {z: 1}}}
	in: r
	out: in
	x: G(L)
}
W3: func(o: _) -> _: F3(o.d)
once3:  W3({d: {}}) @test(eq, {in: {}, out: {}, x: y: z: 1})
twice3: W3({d: once3}) @test(eq, {
	in: {in: {}, out: {}, x: y: z: 1}
	out: {in: {}, out: {}, x: y: z: 1}
	x: y: z: 1
})

// Genuine cycles through function calls are still structural cycles.
cycles: {
	R: func(r: _) -> _: {r, x: R(r)}
	recurse: R({a: 1}) @test(err, code=structural_cycle, contains="structural cycle")

	N: func(r: _) -> _: {sub: r}
	nest: N(nest) @test(err, code=structural_cycle, contains="structural cycle")

	E: func(r: _) -> _: {r}
	self: E(self) @test(err, code=structural_cycle, contains="structural cycle")

	A: W({d: {b: B}})
	B: W({d: {a: A}}) @test(err, code=structural_cycle, contains="structural cycle")
	C: W({d: {c: C}}) @test(err, code=structural_cycle, contains="structural cycle")
}

// A selection through a parameter reaches a field of the vertex that a field
// of the argument shares. Here probe.o is e.l.k, whose call of N was taken for
// a recursion of the call of N made by probe.
lookup: {
	K: func(a: _) -> _: a.l.k
	N: func(a: _) -> _: {c: a.n, o: K({l: a.l})}
	e: l: k: N({n: 1}).c
	d: *{x: 1} | {[string]: _}
	d: e
	probe: N({n: 2, l: d.l}) @test(eq, {c: 2, o: 1})
}

// Without the disjunction on d, the result of the call of N made by e.l.k is
// memoized before probe needs it, which hid the error.
lookupPlain: {
	K: func(a: _) -> _: a.l.k
	N: func(a: _) -> _: {c: a.n, o: K({l: a.l})}
	e: l: k: N({n: 1}).c
	probe: N({n: 2, l: e.l}) @test(eq, {c: 2, o: 1})
}

// Other ways to reach e.l.k through the argument of K.
lookupVia: {
	// The parameter shares the argument itself.
	direct: {
		K: func(a: _) -> _: a.l.k
		N: func(a: _) -> _: {c: a.n, o: K(a.m)}
		e: l: k: N({n: 1, m: l: k: 0}).c
		d: *{x: 1} | {[string]: _}
		d: e
		probe: N({n: 2, m: d}) @test(eq, {c: 2, o: 1})
	}
	index: {
		K: func(a: _) -> _: a.l["k"]
		N: func(a: _) -> _: {c: a.n, o: K({l: a.l})}
		e: l: k: N({n: 1}).c
		d: *{x: 1} | {[string]: _}
		d: e
		probe: N({n: 2, l: d.l}) @test(eq, {c: 2, o: 1})
	}
	embed: {
		K: func(a: _) -> _: {a.l}.k
		N: func(a: _) -> _: {c: a.n, o: K({l: a.l})}
		e: l: k: N({n: 1}).c
		d: *{x: 1} | {[string]: _}
		d: e
		probe: N({n: 2, l: d.l}) @test(eq, {c: 2, o: 1})
	}
	let: {
		K: func(a: _) -> _: {let X = a.l, out: X.k}.out
		N: func(a: _) -> _: {c: a.n, o: K({l: a.l})}
		e: l: k: N({n: 1}).c
		d: *{x: 1} | {[string]: _}
		d: e
		probe: N({n: 2, l: d.l}) @test(eq, {c: 2, o: 1})
	}
	comprehension: {
		K: func(a: _) -> _: {for _, v in a.l {v}}
		N: func(a: _) -> _: {c: a.n, o: K({l: a.l})}
		e: l: k: N({n: 1}).c
		d: *{x: 1} | {[string]: _}
		d: e
		probe: N({n: 2, l: d.l}) @test(eq, {c: 2, o: 1})
	}
	// The argument passes through another call.
	nested: {
		K: func(a: _) -> _: a.m.l.k
		M: func(a: _) -> _: K({m: a})
		N: func(a: _) -> _: {c: a.n, o: M({l: a.l})}
		e: l: k: N({n: 1}).c
		d: *{x: 1} | {[string]: _}
		d: e
		probe: N({n: 2, l: d.l}) @test(eq, {c: 2, o: 1})
	}
	// The argument is a disjunction.
	disjunction: {
		K: func(a: _) -> _: a.l.k
		N: func(a: _) -> _: {c: a.n, o: K(*{l: a.l} | {l: a.l, z: 1})}
		e: l: k: N({n: 1}).c
		d: *{x: 1} | {[string]: _}
		d: e
		probe: N({n: 2, l: d.l}) @test(eq, {c: 2, o: 1})
	}
}

// Recursion through a selection on a parameter is still a structural cycle.
lookupCycles: {
	S: func(a: _) -> _: {v: a.l.k, n: S({l: a.l})}
	select: S({l: k: 1}) @test(err, code=structural_cycle, contains="structural cycle")

	T: func(a: _) -> _: {z: a.l}
	self: T({l: self}) @test(err, code=structural_cycle, contains="structural cycle")

	C: func(a: _) -> _: {for _, v in a {v}}
	comprehension: C({l: comprehension}) @test(err, code=structural_cycle, contains="structural cycle")
}
-- out/errors.txt --

# Tests that an error below an argument of a call, reported at the field
# holding the call, still names its path within the argument: the parameter
# followed by the labels down to the failing field. A closedness error would
# otherwise not name the field it rejects, and distinct failures at the same
# call would read the same. An error at the argument itself names no path.
# The path precedes the outermost message of an error that wraps another,
# such as a failed validator or an invalid interpolation, exactly once.
-- in.cue --
@experiment(functions)

#Cfg: {
	name: string
	opts: port?: int & >0
}

f: func(cfg: #Cfg) -> string: cfg.name

atArg:  f(1) @test(err, code=eval, contains="conflicting values")
extra:  f({name: "a", extra: 1}) @test(err, code=eval, contains="cfg.extra: field not allowed")
deeper: f({name: "a", opts: porrt: 1}) @test(err, code=eval, contains="cfg.opts.porrt: field not allowed")
bound:  f({name: "a", opts: port: 0}) @test(err, code=eval, contains="cfg.opts.port: invalid value 0")

// A call inside a function body, given a value that fails a closed type of
// the inner call only, is reported at the field holding the outer call,
// followed by its path within the result, and names the path within the
// inner call's argument.
#Bus: {
	items: [string]: string
	refs: [string]: {ok: bool}
}
render: func(id: string, bus: #Bus) -> {name: string}: {name: bus.items[id]}
build: func(src: {...}) -> {list: [...]}: {
	list: [for id, _ in src.items {render(id, src)}]
}
nested: build({items: a: "a", refs: a: {ok: true, typo: 1}}) @test(err, code=eval, contains="bus.refs.a.typo: field not allowed")

// A validator failing below an argument wraps the error saying why.
#One: {
	matchN(1, [{a!: _}, {b!: _}])
	a?: int
	b?: int
}
v:         func(cfg: {x: #One}) -> int: 1
validator: v({x: {a: 1, b: 1}}) @test(err, code=eval, contains="cfg.x: invalid value {a:1,b:1} (does not satisfy matchN): 2 matched, expected 1")

// An interpolation of an interpolation wraps the error twice.
s:     func(cfg: {n: int}) -> string: "a\("b\(cfg.n)")"
twice: s({n: 1.5}) @test(err, code=eval, contains="cfg.n: invalid interpolation: invalid interpolation: conflicting values")

// A wrapped error moved out of a call nested in a function body, and out of
// a call nested in an argument.
check:           func(bus: {one: #One}) -> int: 1
viaBody:         func(src: {...}) -> {n: int}: {n: check(src)}
nestedValidator: viaBody({one: {a: 1, b: 1}}) @test(err, code=eval, contains="bus.one: invalid value {a:1,b:1} (does not satisfy matchN): 2 matched")
take:            func(w: {...}) -> int: 1
argValidator:    take({k: check({one: {a: 1, b: 1}})}) @test(err, code=eval, contains="w.k: bus.one: invalid value {a:1,b:1} (does not satisfy matchN): 2 matched")
-- out/errors.txt --

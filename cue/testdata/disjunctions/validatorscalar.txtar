# Tests that a scalar disjunct survives the unification of copies of a
# disjunction whose other disjunct is a validator that the scalar violates.
#
# When a value is a scalar, its validators are checked as soon as its conjuncts
# are in. matchN records the errors of the schemas that failed in the context
# besides the error it returns. Left there, they made the next comparison of two
# scalars in the same evaluation, such as the null of one copy against the null
# of another, report that error instead of its result: the disjunct was
# eliminated, so the unification of three copies of
#
#	matchN(1, [int]) | null
#
# was matchN(1, [int]), and a null written next to two copies was an error.
# v0.17.1 and v0.18.0-rc.1 give the right value; the checks of a scalar ran
# early from v0.18.0-rc.2.
-- in.cue --
import "strings"

// Each test probes the unified field by unifying it with a value of each
// disjunct, rather than comparing it with a disjunction of validators.

// Three copies. The null disjunct of the copies is a scalar that fails the
// validator of the other disjunct, then meets itself.
three: {
	a:   matchN(1, [int]) | null
	a:   matchN(1, [int]) | null
	a:   matchN(1, [int]) | null
	n:   a & null @test(eq, null)
	i:   a & 5    @test(eq, 5)
	bad: a & "x"  @test(err, code=eval)
}

// The same by unification of struct literals, and with more copies.
amp: {
	a:   ({matchN(1, [int])} | null) & ({matchN(1, [int])} | null) & ({matchN(1, [int])} | null)
	n:   a & null @test(eq, null)
	i:   a & 5    @test(eq, 5)
	bad: a & "x"  @test(err, code=eval)
}
four: {
	a:   matchN(1, [int]) | null
	a:   matchN(1, [int]) | null
	a:   matchN(1, [int]) | null
	a:   matchN(1, [int]) | null
	n:   a & null @test(eq, null)
	i:   a & 5    @test(eq, 5)
	bad: a & "x"  @test(err, code=eval)
}
nested: {
	a: x: matchN(1, [int]) | null
	a: x: matchN(1, [int]) | null
	a: x: matchN(1, [int]) | null
	n:   a.x & null @test(eq, null)
	i:   a.x & 5    @test(eq, 5)
	bad: a.x & "x"  @test(err, code=eval)
}

// The order of the disjuncts does not matter.
nullFirst: {
	a:   null | matchN(1, [int])
	a:   null | matchN(1, [int])
	a:   null | matchN(1, [int])
	n:   a & null @test(eq, null)
	i:   a & 5    @test(eq, 5)
	bad: a & "x"  @test(err, code=eval)
}

// Any scalar kind that the validator rejects is affected, not only null.
strScalar: {
	a:   matchN(1, [int]) | "x"
	a:   matchN(1, [int]) | "x"
	a:   matchN(1, [int]) | "x"
	s:   a & "x" @test(eq, "x")
	i:   a & 5   @test(eq, 5)
	bad: a & "y" @test(err, code=eval)
}
boolScalar: {
	a:   matchN(1, [int]) | true
	a:   matchN(1, [int]) | true
	a:   matchN(1, [int]) | true
	b:   a & true @test(eq, true)
	i:   a & 5    @test(eq, 5)
	bad: a & "y"  @test(err, code=eval)
}
numScalar: {
	a:   matchN(1, [string]) | 5
	a:   matchN(1, [string]) | 5
	a:   matchN(1, [string]) | 5
	m:   a & 5   @test(eq, 5)
	s:   a & "x" @test(eq, "x")
	bad: a & 6   @test(err, code=eval)
}

// Schemas and counts other than the simplest.
manySchemas: {
	a:   matchN(1, [int, string]) | null
	a:   matchN(1, [int, string]) | null
	a:   matchN(1, [int, string]) | null
	n:   a & null @test(eq, null)
	i:   a & 5    @test(eq, 5)
	bad: a & true @test(err, code=eval)
}
structSchema: {
	a:   matchN(1, [{x: int}]) | null
	a:   matchN(1, [{x: int}]) | null
	a:   matchN(1, [{x: int}]) | null
	n:   a & null   @test(eq, null)
	s:   a & {x: 1} @test(eq, {x: 1})
	bad: a & "x"    @test(err, code=eval)
}

// A concrete scalar next to copies of the disjunction. Two copies were
// enough: the value met the scalar of the disjunct after the validator failed
// for the other.
concreteNull: {
	a: matchN(1, [int]) | null
	a: matchN(1, [int]) | null
	a: null
	@test(eq, {a: null})
}
concreteString: {
	a: matchN(1, [int]) | "x"
	a: matchN(1, [int]) | "x"
	a: "x"
	@test(eq, {a: "x"})
}

// In a pattern constraint and in a list, where each element repeats.
pattern: {
	a: [string]: matchN(1, [int]) | null
	a: [string]: matchN(1, [int]) | null
	a: [string]: matchN(1, [int]) | null
	a: x:        null
	@test(eq, {a: x: null})
}
listElems: {
	a: [...matchN(1, [int]) | null]
	a: [...matchN(1, [int]) | null]
	a: [...matchN(1, [int]) | null]
	a: [null, 1]
	@test(eq, {a: [null, 1]})
}

// Controls. Two copies were right before.
two: {
	a:   matchN(1, [int]) | null
	a:   matchN(1, [int]) | null
	n:   a & null @test(eq, null)
	i:   a & 5    @test(eq, 5)
	bad: a & "x"  @test(err, code=eval)
}

// A value that satisfies the validator is not affected.
satisfied: {
	a: matchN(1, [int]) | null
	a: matchN(1, [int]) | null
	a: matchN(1, [int]) | null
	a: 5
	@test(eq, {a: 5})
}

// Validators that record no errors of their own are not affected.
minRunes: {
	a:   strings.MinRunes(2) | null
	a:   strings.MinRunes(2) | null
	a:   strings.MinRunes(2) | null
	n:   a & null @test(eq, null)
	s:   a & "ab" @test(eq, "ab")
	bad: a & "a"  @test(err, code=eval)
}

// Identical disjuncts of the copies are still merged: there is one of each
// in the result.
merged: {
	a: 1 | 2
	a: 1 | 2
	a: 1 | 2
	@test(eq, {a: 1 | 2})
}
mergedDefault: {
	a: *1 | 2
	a: *1 | 2
	a: *1 | 2
	@test(eq, {a: *1 | 2})
}
mergedNull: {
	a: int | null
	a: int | null
	a: int | null
	@test(eq, {a: int | null})
}

// A scalar that is not one of the disjuncts is an error, and the error still
// lists why the schemas failed.
rejected: {
	a: matchN(1, [int]) | null
	a: matchN(1, [int]) | null
	a: matchN(1, [int]) | null
	a: "x"
	@test(err, code=eval, contains="empty disjunction")
}
// A validator that records an error without returning one, such as a builtin
// validator given an argument of the wrong type, has failed. The error is the
// validator's own, so it must neither be dropped nor, in the validator of a
// disjunction, be taken for the error of another operation.
badArgument: {
	a: strings.MinRunes("x") & "abc" @test(err, code=eval, contains="argument 2 to strings.MinRunes")
}
badArgumentInMatchN: {
	a: matchN(1, [strings.MinRunes("x")]) & "abc" @test(err, code=eval, contains="does not satisfy matchN")
}
badArgumentDisjunct: {
	a: strings.MinRunes("x") | null
	a: strings.MinRunes("x") | null
	a: strings.MinRunes("x") | null
	a: "abc"
	@test(err, code=eval, contains="empty disjunction")
}

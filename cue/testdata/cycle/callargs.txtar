# Tests that a call is not reported as a structural cycle when it is inherited
# from a cycle that its arguments do not refer to.
#
# With b: c, c: b and b: z: b.v, looking up b while c is evaluated closes a
# cycle on the reference to c in b, and every conjunct b inherits from c is
# marked cyclic, including the call in c: x: len(k). A call in a cyclic
# conjunct was postponed until its node had a non-cyclic conjunct whenever an
# argument had a reference. b.x has none, so it became a structural cycle,
# while c.x evaluated fine, and so did b.x when the call was declared after the
# cycle.
#
# Calls whose arguments do refer to the cycle are still postponed; see
# stillCyclic below and builtins.txtar.
#
# https://cuelang.org/issue/XXXX
-- in.cue --
import "math"

refArg: {
	k: "abc"
	c: x: len(k)
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
structArg: {
	k: {a: 1}
	c: x: len({a: k.a, b: 2})
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 2, at=b.x)
}
importArg: {
	c: x: math.Floor(math.Pi)
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
// The selected field is not in progress, although c is.
selectionArg: {
	c: x: len(c.y)
	c: y: "abc"
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
selfSelectionArg: {
	c: x: len(self.y)
	c: y: "abc"
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
letArg: {
	let K = "abc"
	c: x: len(K)
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
letSelectionArg: {
	c: {
		let S = self
		x: len(S.y)
		y: "abc"
	}
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}

// These evaluated fine before.
literalArg: {
	c: x: len("abc")
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
comprehensionArg: {
	k: [1, 2]
	c: x: len([for v in k {v}])
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 2, at=b.x)
}
callAfterCycle: {
	k: "abc"
	b: c
	c: b
	b: v: 1
	b: z: b.v
	c: x: len(k)
	@test(eq, 3, at=b.x)
}
-- files-a.cue --
// The call is in a file before the one that closes the cycle.
files: {
	config: x: len({a: "x"})
}
-- files-b.cue --
files: {
	blueprint~(_,Bp): {config: Cfg}
	config~(_,Cfg): Bp.config

	blueprint: config: b: 1
	blueprint: config: c: blueprint.config.b

	@test(eq, 1, at=blueprint.config.x)
	@test(eq, 1, at=config.x)
}
-- func.cue --
@experiment(functions)

funcStructArg: {
	f: func(s: _) -> _: s.a
	c: x: f({a: "x"})
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, "x", at=b.x)
}
funcRefArg: {
	f: func(s: _) -> _: s.a
	k: {a: "x"}
	c: x: f(k)
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, "x", at=b.x)
}
-- try.cue --
@experiment(try)

import "encoding/json"

// The references of a try clause are found as for any other clause.
tryArg: {
	k: {a: 1}
	c: x: len({try {a: k.a?}})
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 1, at=b.x)
}
tryAsArg: {
	k: {a: 1}
	c: x: len({try y = k.a? {a: y}})
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 1, at=b.x)
}
// A try clause that refers to the cycle remains a structural cycle.
tryCyclic: {
	x: y: json.Validate({try {s: x?}}.s)
	x: y: "{}"
	@test(err, code=structural_cycle, at=x.y, contains="structural cycle")
}
-- cycle.cue --
import "encoding/json"

// Calls whose arguments refer to the cycle remain structural cycles.
stillCyclic: {
	direct: {
		x: y: json.Validate(x)
		x: y: "{}"
		@test(err, code=structural_cycle, at=x.y, contains="structural cycle")
	}
	indirect: {
		data: #c
		data: a: b: "foo"
		#k: #c
		#c: {
			b: string
			a: matchN(1, [#k])
		}
		@test(err, at=data.a, contains="0 matched, expected 1")
	}
	selection: {
		data: #c
		data: a: b: "foo"
		#c: {
			b: string
			a: matchN(1, [#c.a])
		}
		@test(err, at=data.a, contains="0 matched, expected 1")
	}
	let: {
		x: {
			let L = x
			y: json.Validate(L)
		}
		x: y: "{}"
		@test(err, code=structural_cycle, at=x.y, contains="structural cycle")
	}
}

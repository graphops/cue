# Tests that a call is not reported as a structural cycle when it is inherited
# from a cycle its arguments do not reach.
#
# With `b: c`, `c: b` and `b: z: b.v`, looking up b while c is evaluated closes a cycle on
# the reference to c in b, and every conjunct b inherits from c is marked
# cyclic, including the call in `c: x: f(k)`. A call in a cyclic conjunct was
# postponed until its node had a non-cyclic conjunct, unless all its arguments
# were literals; b.x has none, so it became a structural cycle, depending on
# evaluation order: c.x, and b.x when the call is declared after the cycle,
# evaluate fine.
#
# Calls whose arguments do reach the cycle are still postponed: see
# builtins.txtar and stillCyclic below.
-- a.cue --
@experiment(functions)

// The call is in a file before the one that wires the cycle.
files: {
	_f: func(s: _) -> _: s.a

	config: x: _f({a: "x"})
}
-- b.cue --
files: {
	blueprint~(_,Bp): {config: Cfg}
	config~(_,Cfg): Bp.config

	blueprint: config: b: 1
	blueprint: config: c: blueprint.config.b

	@test(eq, "x", at=blueprint.config.x)
	@test(eq, "x", at=config.x)
}
filesReordered: {
	blueprint~(_,Bp): {config: Cfg}
	config~(_,Cfg): Bp.config

	blueprint: config: b: 1
	blueprint: config: c: blueprint.config.b

	@test(eq, "x", at=blueprint.config.x)
}
-- z.cue --
@experiment(functions)

// The same, with the call in a file after the one that wires the cycle.
filesReordered: {
	_f: func(s: _) -> _: s.a

	config: x: _f({a: "x"})
}
-- in.cue --
@experiment(functions)

import "math"

// Single files: the call is declared before the cycle.
funcStructArg: {
	f: func(s: _) -> _: s.a
	c: x: f({a: "x"})
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, "x", at=b.x)
}
funcIgnoredArg: {
	f: func(s: _) -> _: 1
	c: x: f({})
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 1, at=b.x)
}
funcRefArg: {
	f: func(s: _) -> _: s.a
	k: {a: "x"}
	c: x: f(k)
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, "x", at=b.x)
}
builtinRefArg: {
	k: "abc"
	c: x: len(k)
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
builtinStructArg: {
	k: {a: 1}
	c: x: len({a: k.a, b: 2})
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 2, at=b.x)
}
importArg: {
	c: x: math.Floor(math.Pi)
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
selectionArg: {
	c: x: len(c.y)
	c: y: "abc"
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
selfSelectionArg: {
	c: x: len(self.y)
	c: y: "abc"
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
letArg: {
	let K = "abc"
	c: x: len(K)
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}
letSelectionArg: {
	c: {
		let S = self
		x: len(S.y)
		y: "abc"
	}
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 3, at=b.x)
}

// These evaluated fine before.
comprehensionArg: {
	k: [1, 2]
	c: x: len([for v in k {v}])
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 2, at=b.x)
}
scalarArg: {
	f: func(s: _) -> _: 1
	c: x: f(1)
	b: c
	c: b
	b: v: 1
	b: z: b.v
	@test(eq, 1, at=b.x)
}
callAfterCycle: {
	b: c
	c: b
	b: v: 1
	b: z: b.v
	f: func(s: _) -> _: s.a
	c: x: f({a: "x"})
	@test(eq, "x", at=b.x)
}
-- cycle.cue --
import "encoding/json"

// Calls whose arguments reach the cycle remain structural cycles.
stillCyclic: {
	direct: {
		x: y: json.Validate(x)
		x: y: "{}"
		@test(err, code=structural_cycle, at=x.y, contains="structural cycle")
	}
	indirect: {
		data: #c
		data: a: b: "foo"
		#k: #c
		#c: {
			b: string
			a: matchN(1, [#k])
		}
		@test(err, at=data.a, contains="0 matched, expected 1")
	}
	selection: {
		data: #c
		data: a: b: "foo"
		#c: {
			b: string
			a: matchN(1, [#c.a])
		}
		@test(err, at=data.a, contains="0 matched, expected 1")
	}
}
-- out/errors.txt --

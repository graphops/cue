# Tests a field with a disjunction that is looked up from within a value it
# unifies, as out in out: x & (A | B) when x refers to out. The lookup
# finds x still being evaluated, which marks the conjunct x of out as a
# cycle to an ancestor. That is no structural cycle, as out has other
# conjuncts, so the disjunction of out must still be evaluated, rather than
# be skipped as for a field that is part of a structural cycle.
#
# cmd/cue/cmd/testdata/script/eval_disjunctionlookup.txtar tests the same
# with structure sharing disabled.
# https://cuelang.org/issue/XXXX
-- in.cue --
// The disjunct that matches allows the fields of x.
structs: {
	open: {
		#A: {...} | int
		x: {a: 1, b: out.a}
		out: x & #A
		@test(eq, {#A: {...} | int, x: {a: 1, b: 1}, out: {a: 1, b: 1}})
	}
	closed: {
		#A: {a: int, b: int} | int
		x: {a: 1, b: out.a}
		out: x & #A
		@test(eq, {#A: {a: int, b: int} | int, x: {a: 1, b: 1}, out: {a: 1, b: 1}})
	}
	// A field that no disjunct allows.
	notAllowed: {
		#A: {a: int, b: int} | int
		x: {a: 1, b: out.a, c: 3}
		out: x & #A @test(err, code=eval, contains="empty disjunction")
	}
}

lists: {
	open: {
		#A: [...] | int
		x: [1, out[0]]
		out: x & #A
		@test(eq, {#A: [] | int, x: [1, 1], out: [1, 1]})
	}
	closed: {
		#A: [int, int] | int
		x: [1, out[0]]
		out: x & #A
		@test(eq, {#A: [int, int] | int, x: [1, 1], out: [1, 1]})
	}
	// The elements are structs.
	structElems: {
		#A: [...{a: int}] | int
		x: [{a: 1}, {a: out[0].a}]
		out: x & #A
		@test(eq, {#A: [] | int, x: [{a: 1}, {a: 1}], out: [{a: 1}, {a: 1}]})
	}
}

// The disjuncts must still be checked against x.
conflicts: {
	scalarElems: {
		x: [1, out[0]]
		out: x & ([...string] | int) @test(err, code=eval, contains="empty disjunction")
	}
	structField: {
		x: {a: 1, b: out.a}
		out: x & ({a: 2} | int) @test(err, code=eval, contains="empty disjunction")
	}
}

// The disjunction keeps its default.
defaults: {
	x: {a: 1, b: out.a}
	out: x & (*{c: 1} | {d: 1})
	@test(eq, {x: {a: 1, b: 1}, out: *{a: 1, b: 1, c: 1} | {a: 1, b: 1, d: 1}})
}

// The value read is itself a disjunction, of which only the first disjunct
// is allowed by #D.
disjunctionRead: {
	// The reference to n is in a conjunct of V.
	conjunct: {
		#D: {a: int, c?: _}
		V: (#D & {a: 1}) | {a: 2, b: 3}
		V: c: n.a
		n: V & #D
		@test(eq, {
			#D: {a: int, c?: _}
			V: {a: 1, c: 1} | {a: 2, b: 3, c: 1}
			n: {a: 1, c: 1}
		})
	}
	// The reference to n is in the first disjunct.
	disjunct: {
		#D: {a: int, c?: int}
		V: (#D & {a: 1, c: n.a}) | {a: 2, b: 3}
		n: V & #D
		@test(eq, {
			#D: {a: int, c?: int}
			V: {a: 1, c: 1} | {a: 2, b: 3}
			n: {a: 1, c: 1}
		})
	}
	// #D allows neither disjunct of V: the one referring to n adds c, so
	// only {a: 2, b: 3} is left of V, and #D does not allow b.
	none: {
		#D: {a: int}
		V: (#D & {a: 1, c: n.a}) | {a: 2, b: 3} @test(eq, {a: 2, b: 3})
		n: V & #D @test(err, code=eval, contains="empty disjunction")
	}
	// The same, with the disjuncts swapped.
	noneSwapped: {
		#D: {a: int}
		V: {a: 2, b: 3} | (#D & {a: 1} & {x: n.a}) @test(eq, {a: 2, b: 3})
		n: V & #D @test(err, code=eval, contains="empty disjunction")
	}
}

// A field that x embeds whole is still a structural cycle.
structuralCycle: {
	x: {a: 1, b: out}
	out: x & ({...} | int) @test(err, code=structural_cycle, contains="structural cycle")
}

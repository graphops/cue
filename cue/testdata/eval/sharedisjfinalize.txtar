#inlinetest:exclude golden output records the value of a shared reference
# A reference into a struct whose fields a comprehension adds, unified
# with a disjunction of definitions, keeps the fields the comprehension
# adds: the referenced value is not finalized before its comprehension
# has run.
-- in.cue --
#Map: [string]: string
#Args: #Map | string
#Out: args?: #Args

out: #Out
out: args: x.args
x: args: #A
#A: {
	if true {a: "1"}
}
-- out/evalalpha --
(struct){
  #Map: (#struct){
  }
  #Args: ((string|struct)){ |((#struct){
    }, (string){ string }) }
  #Out: (#struct){
    args?: ((string|struct)){ |((#struct){
      }, (string){ string }) }
  }
  out: (#struct){
    args: (#struct){
      a: (string){ "1" }
    }
  }
  x: (struct){
    args: ~(#A)
  }
  #A: (#struct){
    a: (string){ "1" }
  }
}

# A field declared both outside and in the body of a comprehension depends on
# the clauses of the comprehension. When these fail, the field fails with them,
# rather than taking the value it would have if the comprehension yielded
# nothing. Each out field is evaluated before the struct it selects from, and
# so before the struct records the error.
-- in.cue --
@experiment(try)

incomplete: {
	out: #P.x @test(err, code=incomplete, contains="non-concrete value int in operand to ==", pos=[3:6, 7:5])
	#P: {
		x: [...]
		if b == 1 {
			x: [1]
		}
	}
	b: int
}

fatal: {
	out: p.x @test(err, code=eval, contains="conflicting values 2 and 1", pos=[7:5, 7:9])
	p: {
		x: [...]
		if b {
			x: [1]
		}
	}
	b: 1 & 2 @test(err, code=eval, contains="conflicting values 2 and 1", pos=[0:5, 0:9])
}

// Only the else clause declares x.
fatalElse: {
	out: p.x @test(err, code=eval, contains="conflicting values 2 and 1", pos=[9:5, 9:9])
	p: {
		x: [...]
		if b {
			y: 1
		} else {
			x: [2]
		}
	}
	b: 1 & 2 @test(err, code=eval, contains="conflicting values 2 and 1", pos=[0:5, 0:9])
}

// The guard fails only after the selection of x.
requiredMissing: {
	out: p.x @test(err, code=incomplete, contains="required field missing: mode", pos=[3:10])
	p: {
		x: [...]
		if cfg.mode == "a" {
			x: [1]
		}
	}
	cfg: mode!: string
}

// An embedding and a for loop use the conjuncts of x.
embedding: {
	out: {p.x} @test(err, code=incomplete, contains="non-concrete value int in operand to ==", pos=[3:6, 7:5])
	p: {
		x: [...]
		if b == 1 {
			x: [1]
		}
	}
	b: int
}

forLoop: {
	out: [for v in p {v}] @test(err, at=0, code=incomplete, contains="non-concrete value int in operand to ==", pos=[3:6, 7:5])
	p: {
		x: [...]
		if b == 1 {
			x: [1]
		}
	}
	b: int
}

nested: {
	out: p.a.x @test(err, code=incomplete, contains="non-concrete value int in operand to ==", pos=[3:6, 7:5])
	p: {
		a: x: [...]
		if b == 1 {
			a: x: [1]
		}
	}
	b: int
}

nestedComprehension: {
	out: p.x @test(err, code=incomplete, contains="non-concrete value int in operand to ==", pos=[3:6, 9:5])
	p: {
		x: [...]
		if b == 1 {
			for v in [1] {
				x: [v]
			}
		}
	}
	b: int
}

// x is declared outside the failing comprehension only by another one.
otherComprehension: {
	out: p.x @test(err, code=incomplete, contains="non-concrete value int in operand to ==", pos=[2:6, 9:5])
	p: {
		if b == 1 {
			x: [1]
		}
		if true {
			x: [...]
		}
	}
	b: int
}

// The comprehension does not declare y.
otherField: {
	x: p.x @test(err, code=incomplete, contains="non-concrete value int in operand to ==", pos=[5:6, 9:5])
	y: p.y @test(eq, 1)
	p: {
		x: [...]
		y: 1
		if b == 1 {
			x: [1]
		}
	}
	b: int
}

// The guard becomes concrete in an instance of the definition.
instance: {
	out: q.x @test(eq, [1])
	q: #P & {b: 1}
	#P: {
		b: int
		x: [...]
		if b == 1 {
			x: [1]
		}
	}
}

conditionFalse: {
	out: p.x @test(eq, [])
	p: {
		x: [...]
		if b == 2 {
			x: [1]
		}
	}
	b: 1
}

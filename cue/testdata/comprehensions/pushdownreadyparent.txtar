# Tests that an arc that a pushed-down comprehension declares does not
# complete its value before that comprehension has run.
#
# Iterating over x.paths creates the arc u as a pending placeholder, whose
# only parent task is the if comprehension that declares it. paths does not
# count that comprehension (its dependency was pushed down onto u), so u was
# signaled allAncestorsProcessed, and stateCompletions completed and froze
# its value while u still had no conjuncts or tasks. The comprehension then
# added cfg.p to u too late: the interpolation saw only the pattern string.
-- in.cue --
@experiment(try)

forSource: {
	out: [for k, p in x.paths {"s3://\(p)"}] @test(eq, ["s3://v"])
	x: {
		paths: [string]: string
		paths: {if cfg.on {u: cfg.p}}
	}
	cfg: {on: true, p: "v"}
}

sibling: {
	out: x.data @test(eq, {u: "s3://v"})
	x: {
		paths: [string]: string & !=""
		paths: {if cfg.on {u: cfg.p}}
		data: {for k, p in paths {(k): "s3://\(p)"}}
	}
	cfg: {on: true, p: "v"}
}

# Tests that a ?-marked reference tests whether a field exists, whatever makes
# it absent: a closed struct that does not declare a field simply has no such
# field, so the try clause is discarded and its else clause runs.
#
# An absent field used to be a permanent error if the lookup found the struct
# closed, but only an incomplete one if it had not been evaluated yet, as its
# closedness is only recorded once its conjuncts are processed. The outcome of
# a try clause thus depended on evaluation order, and with it on the order of
# fields, as in plainClosed.valueFirst and plainClosed.valueLast. Selecting
# from a disjunction always evaluates its disjuncts first, so a default branch
# that does not declare the field always failed, as in defaultDisjunct.
#
# Only absence is forgiven: see stillErrors.
-- in.cue --
@experiment(try)

plainClosed: {
	// The two orders of the same fields must agree.
	valueFirst: {
		#D: {a: int}
		d: #D & {a: 1}
		out: {try {v: d.y?} else {w: 1}} @test(eq, {w: 1})
	}

	valueLast: {
		out: {try {v: d.y?} else {w: 1}} @test(eq, {w: 1})
		#D: {a: int}
		d: #D & {a: 1}
	}

	noElse: {
		#D: {a: int}
		d: #D & {a: 1}
		out: {try {v: d.y?}} @test(eq, {})
	}
	sameStruct: {
		#D: {a: int}
		out: {
			d: #D & {a: 1}
			try {v: d.y?} else {w: 1}
		} @test(eq, {d: {a: 1}, w: 1})
	}
	schema: {
		#D: {a: int}
		out: {try {v: #D.y?}} @test(eq, {})
	}
	shared: {
		#D: {a: int}
		e: #D & {a: 1}
		d: e
		out: {try {v: d.y?}} @test(eq, {})
	}
	closeBuiltin: {
		d: close({a: 1})
		out: {try x = d.y? {v: x}} @test(eq, {})
	}
	nestedField: {
		#D: {a: b: int}
		d: #D & {a: b: 1}
		out: {try x = d.a.y? {v: x}} @test(eq, {})
	}
	indexedByString: {
		#D: {a: int}
		d: #D & {a: 1}
		out: {try {v: d["y"]?}} @test(eq, {})
	}
	declaredOptional: {
		#D: {a: int, y?: int}
		d: #D & {a: 1}
		out: {try {v: d.y?}} @test(eq, {})
	}
	present: {
		#D: {a: int}
		d: #D & {a: 1}
		out: {try {v: d.a?}} @test(eq, {v: 1})
	}
}

defaultDisjunct: {
	#S: {k: *{t: "a"} | {t: "b", y?: int}}

	default: {
		d: #S
		out: {try {v: d.k.y?}} @test(eq, {})
	}
	bound: {
		d: #S
		out: {try x = d.k.y? {v: x}} @test(eq, {})
	}
	elseClause: {
		d: #S
		out: {try x = d.k.y? {v: x} else {w: 1}} @test(eq, {w: 1})
	}
	inDefinition: {
		#T: {
			k: *{t: "a"} | {t: "b", y?: int}
			try x = k.y? {v: x}
		}
		d: #T
		out: len([for k, _ in d {k}]) @test(eq, 1)
	}
	definitionsAsBranches: {
		#A: {t: "a"}
		#B: {t: "b", y: int}
		d: *#A | #B
		out: {try x = d.y? {v: x}} @test(eq, {})
	}
	orNull: {
		#A: {t: "a"}
		d: *#A | null
		out: {try x = d.y? {v: x}} @test(eq, {})
	}
	// Selecting the default branch leaves a plain closed struct.
	defaultSelected: {
		d: #S & {k: t: "a"}
		out: {try {v: d.k.y?}} @test(eq, {})
	}
	otherSelectedWithField: {
		d: #S & {k: {t: "b", y: 2}}
		out: {try {v: d.k.y?}} @test(eq, {v: 2})
	}
	otherSelectedWithoutField: {
		d: #S & {k: t: "b"}
		out: {try {v: d.k.y?}} @test(eq, {})
	}
	noBranchDeclaresIt: {
		d: #S
		out: {try {v: d.k.z?}} @test(eq, {})
	}
}

nested: {
	#S: {k: *{t: "a"} | {t: "b", m?: {s?: {on: *true | bool}}}}

	default: {
		d: #S
		out: {try x = d.k.m?.s? {v: x.on}} @test(eq, {})
	}
	otherSelected: {
		d: #S & {k: {t: "b", m: s: on: true}}
		out: {try x = d.k.m?.s? {v: x.on}} @test(eq, {v: true})
	}
	otherSelectedInnerAbsent: {
		d: #S & {k: {t: "b", m: {}}}
		out: {try x = d.k.m?.s? {v: x.on}} @test(eq, {})
	}
	insideStruct: {
		#T: {a: b: *{t: "a"} | {t: "b", y?: z: int}}
		d: #T
		out: {try {v: d.a.b.y?.z?}} @test(eq, {})
	}
}

// A ?-marked reference only forgives its own field being absent.
stillErrors: {
	#D: {a: int}
	#S: {k: *{t: "a"} | {t: "b", y?: int}}

	notMarked: {
		d: #D & {a: 1}
		out: {try {v: d.y}} @test(err, code=eval, path=v, contains="undefined field: %s", args=[y])
	}
	notInTry: {
		d: #D & {a: 1}
		out: {v: d.y} @test(err, code=eval, path=v, contains="undefined field: %s", args=[y])
	}
	defaultNotMarked: {
		d: #S
		out: {try {v: d.k.y}} @test(err, code=eval, path=v, contains="undefined field: %s", args=[y])
	}
	defaultNotInTry: {
		d: #S
		out: {v: d.k.y} @test(err, code=eval, path=v, contains="undefined field: %s", args=[y])
	}
	// The unmarked y is not forgiven by the marked z behind it.
	nestedUnmarked: {
		d: #S
		out: {try {v: d.k.y.z?}} @test(err, code=eval, path=v, contains="undefined field: %s", args=[y])
	}
	notAStruct: {
		d: "a"
		out: {try {v: d.y?} else {w: 1}} @test(err, code=eval, path=v, contains="invalid operand d (found string, want list or struct)")
	}
	fieldOfList: {
		d: [1]
		out: {try {v: d.y?} else {w: 1}} @test(err, code=eval, path=v, contains="undefined field: y")
	}
	closedListIndex: {
		d: [1]
		out: {try {v: d[1]?} else {w: 1}} @test(err, code=eval, path=v, contains="index out of range [1] with length 1")
	}
	indexOfStruct: {
		d: #D & {a: 1}
		out: {try {v: d[0]?} else {w: 1}} @test(err, code=eval, path=v, contains="invalid index 0 (found struct, want list)")
	}
	erroneousValue: {
		d: {a: 1 / 0} @test(err, code=eval, contains="division by zero")
		out: {try {v: d.y?} else {w: 1}} @test(err, code=eval, contains="division by zero")
	}
}

    ./in.cue:5:5
    ./in.cue:8:12
    ./in.cue:71:13
[eval] tryInline.c.enabled: conflicting values true and false:
    ./in.cue:23:14
    ./in.cue:27:12
[eval] ifGuard.c.enabled: conflicting values true and false:
    ./in.cue:35:5
    ./in.cue:38:12
    ./in.cue:83:13

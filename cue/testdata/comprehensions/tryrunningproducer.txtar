    ./in.cue:5:5
    ./in.cue:8:12
    ./in.cue:140:13
[eval] tryDiscarded.c.enabled: conflicting values true and false:
    ./in.cue:16:5
    ./in.cue:19:12
    ./in.cue:152:13
[eval] tryInline.c.enabled: conflicting values true and false:
    ./in.cue:34:14
    ./in.cue:38:12

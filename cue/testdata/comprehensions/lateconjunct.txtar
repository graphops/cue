	}
	for _, _ in r {
		n: a: {f: func(x: int) -> int}
	}
} @test(err, code=eval, path=n.a, contains="changed after evaluation")

functionTypeResult: {
	n: a: {f: func(x: int) -> int}
	r: a: 1
	for _, _ in r {
		if n.a == _|_ {r: x: 2}
	}
	for _, _ in r {
		n: a: {f: func(x: int) -> 1}
	}
} @test(err, code=eval, path=n.a, contains="changed after evaluation")

# a unifies x, so it must have every field x has,
# including y, which the comprehension adds to x.
exec cue export in.cue
cmp stdout want
-- in.cue --
a: x & {z: 1}
x: on: true
if a.on {
	x: y: 1
}
-- want --
{
    "a": {
        "on": true,
        "y": 1,
        "z": 1
    },
    "x": {
        "on": true,
        "y": 1
    }
}

# The guard never becomes concrete.
! exec cue export incomplete.cue
! stdout .
stderr 'non-concrete value int in operand to =='

# The guard is an error.
! exec cue export -e out fatal.cue
! stdout .
stderr 'conflicting values 2 and 1'

-- incomplete.cue --
out: #P.x
#P: {
	x: [...]
	if _b == 1 {
		x: [1]
	}
}
_b: int
-- fatal.cue --
out: p.x
p: {
	x: [...]
	if b {
		x: [1]
	}
}
b: 1 & 2

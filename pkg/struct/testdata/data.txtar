# struct.Data returns concrete data: regular fields with defaults resolved,
# as fresh literals that carry none of the input's defaults or constraints.
-- in.cue --
import (
	"encoding/json"
	"struct"
)

#Child: {
	name: *"child" | string
	n:    *2 | int
	list: [...{a: *1 | int}]
	...
}
src: {
	name: *"src" | string
	n:    *3 | int
	b:    'bytes'
	list: [{a: *5 | int}]
	#def:    1
	_hidden: 1
	opt?:    string
}
// Defaults of the source win over the child's, instead of conflicting.
child: #Child & struct.Data(src)
// Closedness is dropped, as data is open.
open: struct.Data(close({a: 1})) & {b: 2}
// Bytes stay bytes.
bytes: struct.Data(src).b
incomplete: struct.Data({a: string})

// An error keeps its code, as with json.Unmarshal(json.Marshal(v)): a value
// that is only incomplete, such as one that reads an optional field, makes the
// call incomplete instead of failing it, so that a field nobody asks to be
// concrete does not fail evaluation, and a later value can still complete it.
opt: {c?: int}
optional:     struct.Data({a: opt.c})
optionalJSON: json.Unmarshal(json.Marshal({a: opt.c}))
nested:       struct.Data({a: [{b: opt.c}]})
later: {c?: int}
later: c:      4
completed:     struct.Data({a: later.c})
conflict:      struct.Data({a: 1 & 2})
-- out/structs-v3 --
Errors:
conflict: error in call to struct.Data: conflicting values 2 and 1:
    ./in.cue:40:16
    ./in.cue:40:32
    ./in.cue:40:36

Result:
import (
	"struct"
	"encoding/json"
)

#Child: {
	name: *"child" | string
	n:    *2 | int
	list: [...{a: *1 | int}]
}
src: {
	name: *"src" | string
	n:    *3 | int
	b:    'bytes'
	list: [{a: *5 | int}]
	#def: 1
	opt?: string
}
// Defaults of the source win over the child's, instead of conflicting.
child: {
	name: "src"
	n:    3
	b:    'bytes'
	list: [{a: 5}]
}
// Closedness is dropped, as data is open.
open: {
	a: 1
	b: 2
}
// Bytes stay bytes.
bytes:      'bytes'
incomplete: struct.Data({a: string})

// An error keeps its code, as with json.Unmarshal(json.Marshal(v)): a value
// that is only incomplete, such as one that reads an optional field, makes the
// call incomplete instead of failing it, so that a field nobody asks to be
// concrete does not fail evaluation, and a later value can still complete it.
opt: c?: int
optional:     struct.Data({a: opt.c})
optionalJSON: json.Unmarshal(json.Marshal({a: opt.c}))
nested:       struct.Data({a: [{b: opt.c}]})
later: c:     4
completed: a: 4
conflict: _|_ // conflict: error in call to struct.Data: a: conflicting values 2 and 1
